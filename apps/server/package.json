{
  "name": "@atlas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 tsx watch src/index.ts",
    "start": "NODE_USE_ENV_PROXY=1 tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@atlas/instruments": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "postgres": "^3.4.5",
    "ws": "^8.21.3",
    "zod": "^4.6.5",
    "@atlas/core": "workspace:*"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.4.2",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.19.2"
  }
}
