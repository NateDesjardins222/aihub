# Atlas server — example environment (placeholders only; never commit real values).
#
# This file documents the Rithmic (R | Protocol) M9 settings. Copy the keys you
# need into a local .env. Credentials are read SERVER-SIDE ONLY and are never
# logged, returned by an API, sent to the browser, or placed in an error.

# --- Rithmic Test integration (M9) -------------------------------------------
# All ship OFF. The real transport is only reached when RITHMIC_ENABLED=true AND
# credentials are present AND the per-capability gate is on. Only the TEST
# environment is exercised by M9; LIVE stays additionally gated by
# EXTERNAL_LIVE_ENABLED.
RITHMIC_ENABLED=false
RITHMIC_ENVIRONMENT=TEST
RITHMIC_ENDPOINT=wss://rituz00100.rithmic.com:443
RITHMIC_SYSTEM_NAME=Rithmic Test
RITHMIC_MARKET_DATA_ENABLED=false
RITHMIC_EXECUTION_ENABLED=false

# Local, gitignored copy of the official RProtocolAPI package's proto dir.
# See docs/rithmic/rithmic-local-setup.md. Leave blank to use the default
# apps/server/vendor/rithmic/proto location.
RITHMIC_VENDOR_DIR=

# Credentials — NEVER commit real values. The owner sets these locally only.
RITHMIC_USER=
RITHMIC_PASSWORD=

# Non-secret Rithmic identity/config (optional).
RITHMIC_ENV=test
RITHMIC_GATEWAY=
RITHMIC_SYSTEM=
RITHMIC_FCM_ID=
RITHMIC_IB_ID=
RITHMIC_APP_NAME=Atlas
RITHMIC_APP_VERSION=

# External live capital stays disabled. Do not enable for Rithmic Test.
EXTERNAL_LIVE_ENABLED=false

# ---------------------------------------------------------------------------
# Whop commerce (SANDBOX ONLY in this phase). NEVER commit real values.
# The whole commerce lifecycle runs without these; they turn the real money
# path on. See docs/WHOP_PROVIDER_CONTRACT.md and docs/WHOP_CORE50_CANARY_RUNBOOK.md.
# ---------------------------------------------------------------------------
# Webhook signing secret from the Whop dashboard (Standard Webhooks, "ws_..."),
# stored EXACTLY as Whop gives it. Absent -> the webhook refuses every request
# and there is no money path. SECRET — owner sets locally only.
WHOP_WEBHOOK_SECRET=
# Sandbox company/app API key (used server-side to create a checkout). SECRET.
WHOP_COMPANY_API_KEY=
# Non-secret Whop company id (biz_...).
WHOP_COMPANY_ID=
# Hard gate: must be exactly "true" to allow checkout-session creation.
WHOP_SANDBOX=false
# Where Whop returns the buyer after checkout (e.g. https://app.example/portal/billing).
WHOP_CHECKOUT_RETURN_URL=
# Authoritative product mapping, JSON { "<internal product key>": "<Whop plan id>" }.
# CORE 50K canary needs ONE entry; the other nine are added here (config, not code).
# Example: {"htf-core-50k":"plan_XXXXXXXX"}
WHOP_PLAN_MAP=
