{
  "name": "atlas-futures-terminal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @atlas/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --parallel --filter @atlas/server --filter @atlas/web dev",
    "db:generate": "pnpm --filter @atlas/server db:generate",
    "db:migrate": "pnpm --filter @atlas/server db:migrate",
    "db:seed": "pnpm --filter @atlas/server db:seed",
  "db:reconcile": "pnpm --filter @atlas/server exec tsx scripts/reconcile-products.ts",
    "test:browser": "node tests/browser/run.mjs",
    "audit:candles": "node tools/candle-audit.mjs",
    "audit:latency": "node tools/latency-probe.mjs",
    "audit:drawings": "node tools/drawing-matrix.mjs",
    "diagnose": "node tools/diagnose-all.mjs",
    "diagnose:mutations": "node tools/diagnose-mutations.mjs",
    "diagnose:authorization": "node tools/diagnose-authorization.mjs",
    "diagnose:fuzz": "node tools/diagnose-fuzz.mjs",
    "diagnose:multitab": "node tools/diagnose-multitab.mjs",
    "diagnose:torture": "node tools/exec-torture.mjs",
    "diagnose:latency": "node tools/exec-latency.mjs",
    "diagnose:chaos": "node tools/diagnose-chaos.mjs",
    "diagnose:interrupt": "node tools/diagnose-interrupt.mjs",
    "diagnose:lifecycle": "node tools/diagnose-lifecycle.mjs",
    "security:fuzz": "pnpm --filter @atlas/server exec tsx ../../scripts/fuzz-security.ts",
    "security:torture": "pnpm --filter @atlas/server exec tsx ../../scripts/torture-security.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "1.56.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  }
}
